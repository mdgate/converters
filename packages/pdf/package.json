{
  "name": "@mdgate/pdf",
  "version": "0.5.5",
  "description": "mdgate PDF converter",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./maps.bin": "./dist/maps.bin"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.bin"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts && cp src/generated/maps.bin dist/maps.bin",
    "gen:maps": "python3 scripts/gen-maps.py",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/core": "0.5.5",
    "@mdgate/utils": "0.5.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "pdf"
  ]
}
