{
  "name": "@mdgate/iwork-common",
  "version": "0.5.2",
  "description": "mdgate shared Apple iWork (Pages/Numbers/Keynote) IWA parsing",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/containers": "0.5.2",
    "@mdgate/core": "0.5.2",
    "@mdgate/document": "0.5.2",
    "@mdgate/utils": "0.5.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "iwork",
    "pages",
    "numbers",
    "keynote"
  ]
}
