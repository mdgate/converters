{
  "name": "@mdgate/converters",
  "version": "0.3.0",
  "description": "Official mdgate converter bundle",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/core": "0.1.3",
    "@mdgate/csv": "0.1.0",
    "@mdgate/doc": "0.1.0",
    "@mdgate/docx": "0.1.0",
    "@mdgate/epub": "0.1.0",
    "@mdgate/image": "0.1.1",
    "@mdgate/keynote": "0.1.0",
    "@mdgate/numbers": "0.1.0",
    "@mdgate/odf": "0.1.0",
    "@mdgate/pages": "0.1.0",
    "@mdgate/pdf": "0.1.6",
    "@mdgate/ppt": "0.1.0",
    "@mdgate/pptx": "0.1.0",
    "@mdgate/rtf": "0.1.0",
    "@mdgate/xlsx": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "converter",
    "docx",
    "pdf",
    "xlsx",
    "pptx",
    "doc",
    "ppt",
    "rtf",
    "odt",
    "epub",
    "csv",
    "pages",
    "numbers",
    "keynote"
  ]
}
