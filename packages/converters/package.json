{
  "name": "@mdgate/converters",
  "version": "0.6.10",
  "description": "Pure TypeScript converters for 150+ file types, including DOCX, PDF, PPTX, XLSX, iWork, HWP, and email. Runs in Node, Edge, and browsers.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://convert.mdgate.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdgate/converters.git",
    "directory": "packages/converters"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/audio": "0.6.10",
    "@mdgate/core": "0.6.10",
    "@mdgate/csv": "0.6.10",
    "@mdgate/data": "0.6.10",
    "@mdgate/doc": "0.6.10",
    "@mdgate/docx": "0.6.10",
    "@mdgate/email": "0.6.10",
    "@mdgate/epub": "0.6.10",
    "@mdgate/fb2": "0.6.10",
    "@mdgate/html": "0.6.10",
    "@mdgate/hwp": "0.6.10",
    "@mdgate/image": "0.6.10",
    "@mdgate/ipynb": "0.6.10",
    "@mdgate/keynote": "0.6.10",
    "@mdgate/latex": "0.6.10",
    "@mdgate/mobi": "0.6.10",
    "@mdgate/numbers": "0.6.10",
    "@mdgate/odf": "0.6.10",
    "@mdgate/onenote": "0.6.10",
    "@mdgate/pages": "0.6.10",
    "@mdgate/pdf": "0.6.10",
    "@mdgate/ppt": "0.6.10",
    "@mdgate/pptx": "0.6.10",
    "@mdgate/rtf": "0.6.10",
    "@mdgate/subtitle": "0.6.10",
    "@mdgate/text": "0.6.10",
    "@mdgate/video": "0.6.10",
    "@mdgate/visio": "0.6.10",
    "@mdgate/wps": "0.6.10",
    "@mdgate/xlsx": "0.6.10",
    "@mdgate/zip": "0.6.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "converter",
    "docx",
    "pdf",
    "xlsx",
    "pptx",
    "doc",
    "ppt",
    "rtf",
    "odt",
    "epub",
    "csv",
    "pages",
    "numbers",
    "keynote",
    "html",
    "email",
    "ipynb",
    "svg",
    "fb2",
    "mobi",
    "latex",
    "visio",
    "onenote",
    "hwp",
    "wps",
    "zip",
    "text",
    "json",
    "srt",
    "audio",
    "video"
  ]
}
