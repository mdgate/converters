{
  "name": "@mdgate/text",
  "version": "0.6.11",
  "description": "mdgate plain text, markdown, and source converter",
  "type": "module",
  "license": "MIT",
  "homepage": "https://convert.mdgate.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdgate/converters.git",
    "directory": "packages/text"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/core": "0.6.11",
    "@mdgate/document": "0.6.11",
    "@mdgate/utils": "0.6.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "text"
  ]
}
