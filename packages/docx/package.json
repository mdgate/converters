{
  "name": "@mdgate/docx",
  "version": "0.6.25",
  "description": "mdgate Word converter (docx/docm)",
  "type": "module",
  "license": "MIT",
  "homepage": "https://convert.mdgate.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdgate/converters.git",
    "directory": "packages/docx"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/containers": "0.6.25",
    "@mdgate/core": "0.6.25",
    "@mdgate/document": "0.6.25",
    "@mdgate/office-common": "0.6.25",
    "@mdgate/utils": "0.6.25"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "docx",
    "word"
  ]
}
