{
  "name": "@mdgate/image",
  "version": "0.1.0",
  "description": "Image-to-markdown plugin for mdgate: image(fn)",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/core": "0.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "image"
  ]
}
