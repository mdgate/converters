{
  "name": "@mdgate/wps",
  "version": "0.6.14",
  "description": "mdgate Kingsoft WPS converter (wps/et/dps)",
  "type": "module",
  "license": "MIT",
  "homepage": "https://convert.mdgate.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdgate/converters.git",
    "directory": "packages/wps"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/containers": "0.6.14",
    "@mdgate/core": "0.6.14",
    "@mdgate/doc": "0.6.14",
    "@mdgate/document": "0.6.14",
    "@mdgate/docx": "0.6.14",
    "@mdgate/ppt": "0.6.14",
    "@mdgate/pptx": "0.6.14",
    "@mdgate/utils": "0.6.14",
    "@mdgate/xlsx": "0.6.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "wps",
    "et",
    "dps",
    "kingsoft"
  ]
}
