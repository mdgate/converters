{
  "name": "@mdgate/hwp",
  "version": "0.4.1",
  "description": "mdgate Hangul HWP / HWPX converter",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/containers": "0.4.1",
    "@mdgate/core": "0.4.1",
    "@mdgate/document": "0.4.1",
    "@mdgate/utils": "0.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "hwp",
    "hwpx",
    "hangul",
    "hancom"
  ]
}
