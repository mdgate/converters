{
  "name": "@mdgate/utils",
  "version": "0.6.20",
  "description": "Internal text, byte, inflate, and legacy-encoding helpers for mdgate converters",
  "type": "module",
  "license": "MIT",
  "homepage": "https://convert.mdgate.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdgate/converters.git",
    "directory": "packages/utils"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate"
  ]
}
