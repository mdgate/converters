{
  "name": "@mdgate/epub",
  "version": "0.6.6",
  "description": "mdgate EPUB converter",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/containers": "0.6.6",
    "@mdgate/core": "0.6.6",
    "@mdgate/document": "0.6.6",
    "@mdgate/html": "0.6.6",
    "@mdgate/office-common": "0.6.6",
    "@mdgate/utils": "0.6.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "epub",
    "ebook"
  ]
}
