{
  "name": "@mdgate/office",
  "version": "0.1.1",
  "description": "mdgate office converter (doc/docx/ppt/pptx/xls/xlsx/odf/rtf/epub/csv)",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/core": "0.1.3",
    "@mdgate/utils": "0.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "docx",
    "xlsx",
    "pptx",
    "odt",
    "rtf",
    "epub",
    "csv"
  ]
}
