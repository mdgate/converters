{
  "name": "@mdgate/fb2",
  "version": "0.5.7",
  "description": "mdgate FictionBook (FB2) converter",
  "type": "module",
  "license": "MIT",
  "homepage": "https://demo.mdgate.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdgate/converters.git",
    "directory": "packages/fb2"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/containers": "0.5.7",
    "@mdgate/core": "0.5.7",
    "@mdgate/document": "0.5.7",
    "@mdgate/utils": "0.5.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "markdown",
    "fb2",
    "fictionbook"
  ]
}
