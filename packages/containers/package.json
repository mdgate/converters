{
  "name": "@mdgate/containers",
  "version": "0.6.2",
  "description": "mdgate container parsing: ZIP/OPC packages, OLE compound files, XML",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@mdgate/core": "0.6.2",
    "@mdgate/utils": "0.6.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mdgate",
    "zip",
    "opc",
    "ole",
    "cfb",
    "xml"
  ]
}
